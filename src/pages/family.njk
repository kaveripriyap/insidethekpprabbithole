---js
{
  pagination: { data: "familyPages", size: 1, alias: "fp" },
  permalink: (data) => data.fp.family.url,
  layout: "layouts/base.njk",
  bodyClass: "inside",
  themeColour: "hole",
  eleventyComputed: {
    title: (data) => data.fp.family.name,
    description: (data) => data.fp.family.blurb,
    card: (data) => ({ title: data.fp.family.name, kicker: "A chamber in the burrow", chip: data.fp.family.blurb ? "" : "", chipColour: data.fp.family.colour }),
  },
}
---
{%- set s = fp.shelf %}
{%- set fam = fp.family %}
{%- set mine = collections.items | byShelf(s.key) | byFamily(fam.key) %}
<section class="drawer chamber-page paint-{{ fam.colour }}" aria-labelledby="drawer-title">
  <header class="drawer__head">
    <p class="kicker"><a href="/{{ s.url }}/">{{ s.title }}</a> <span aria-hidden="true">↘</span> chamber</p>
    <h1 id="drawer-title" class="drawer__title chamber-page__title">{{ fam.name }}</h1>
    <p class="drawer__intro">{{ fam.blurb }}</p>
    <p class="kicker">{{ mine.length }} {{ s.singular }}{{ "s" if mine.length != 1 }}</p>
  </header>
  {%- if mine.length %}
  <ul class="finds finds--drawer" role="list">
    {% asyncEach item in mine %}{% include "partials/find-card.njk" %}{% endeach %}
  </ul>
  {%- else %}
  <p class="drawer__empty">This chamber is empty for now. Give a {{ s.singular }} <code>family: {{ fam.key }}</code> to put it here.</p>
  {%- endif %}
  <p class="drawer__back"><a href="/{{ s.url }}/">See every {{ s.singular }} <span aria-hidden="true">→</span></a></p>
</section>
