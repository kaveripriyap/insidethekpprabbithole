---js
{
  pagination: { data: "shelves", size: 1, alias: "s" },
  permalink: (data) => `/${data.s.url}/`,
  layout: "layouts/base.njk",
  bodyClass: "inside",
  themeColour: "hole",
  eleventyComputed: {
    title: (data) => data.s.title,
    description: (data) => data.s.intro || `Every ${data.s.singular} in the KPP rabbit hole.`,
    card: (data) => ({ title: data.s.title, kicker: "The whole drawer" }),
  },
}
---
{%- set mine = collections.items | byShelf(s.key) %}
<section class="drawer" aria-labelledby="drawer-title">
  <header class="drawer__head">
    <p class="kicker kicker--glow">The whole drawer · {{ mine.length }} {{ s.singular }}{{ "s" if mine.length != 1 }}</p>
    <h1 id="drawer-title" class="drawer__title">{{ s.title }}</h1>
    {%- if s.intro %}<p class="drawer__intro">{{ s.intro }}</p>{% endif %}
    {%- if s.families.length %}
    <nav class="map" aria-label="Families">
      <ol class="map__list">
        {%- for fam in s.families %}{% set n = (mine | byFamily(fam.key)).length %}{% if n %}
        <li><a class="map__link paint-{{ fam.colour }}" href="{{ fam.url }}"><span class="map__dot" aria-hidden="true"></span>{{ fam.name }} <span class="map__n">{{ n }}</span></a></li>
        {%- endif %}{% endfor %}
      </ol>
    </nav>
    {%- endif %}
  </header>
  {%- if mine.length %}
  <ul class="finds finds--drawer" role="list">
    {% asyncEach item in mine %}{% include "partials/find-card.njk" %}{% endeach %}
  </ul>
  {%- else %}
  <p class="drawer__empty">Nothing on this shelf yet. Add a file to <code>content/{{ s.key }}/</code> and it appears here.</p>
  {%- endif %}
</section>
