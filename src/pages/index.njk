---js
{
  permalink: "/",
  layout: "layouts/base.njk",
  bodyClass: "home",
  themeColour: "periwinkle",
  card: { title: "Inside the KPP Rabbit Hole", kicker: "Oddly useful." }
}
---
{%- set s = "things" | shelf %}
{%- set things = collections.items | byShelf("things") %}
{%- set pops = things | featured | limit(6) %}

<section class="fall" data-fall aria-labelledby="hero-title">
  <div class="fall__stage">
    <div class="fall__words">
      <p class="fall__who">Kinnera <span>&amp;</span> Kaveri <span class="fall__cities">· Berlin · Singapore · Frankfurt · Hyderabad</span></p>
      <h1 id="hero-title" class="fall__title">
        <span class="fall__l1">Inside the</span>
        <span class="fall__l2">KPP</span>
        <span class="fall__l3">Rabbit Hole</span>
      </h1>
    </div>

    <div class="fall__hole" data-ears>
      <svg class="fall__back" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
        <defs><clipPath id="above-the-lip"><path d="M-60-60H160V74H94A44 6 0 0 0 6 74H-60Z"/></clipPath></defs>
        <ellipse class="fall__ellipse" cx="50" cy="74" rx="44" ry="16"/>
        <g clip-path="url(#above-the-lip)">
          <g class="ear ear--left"><g class="ear__in"><path d="M31 84C26 60 20 33 26 16C30 4 45 5 47 18C49 36 50 60 50 84Z" transform="rotate(-10 40 78)"/></g></g>
          <g class="ear ear--right"><g class="ear__in"><path d="M52 84C51 64 52 42 58 27C62 15 77 16 76 29C74 46 70 64 70 84Z" transform="rotate(12 61 78)"/></g></g>
        </g>
      </svg>
      {%- if pops.length %}
      <ul class="pops" aria-label="A few things that just fell out">
        {%- for item in pops %}{% set img = item.data.images[0] %}
        <li class="pop pop--{{ loop.index }}">
          <a href="{{ item.url }}" class="pop__link">
            {% photo img.src, img.alt, "hero", "(min-width: 60em) 9rem, 22vw", { class: "pop__img" } %}
            <span class="pop__name">{{ item.data.title }}</span>
          </a>
        </li>
        {%- endfor %}
      </ul>
      {%- endif %}
      <svg class="fall__front" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
        <path class="fall__lip" d="M6 74A44 16 0 0 0 94 74A44 6 0 0 0 6 74Z"/>
      </svg>
    </div>

    <p class="fall__in" aria-hidden="true">You're in.</p>

    <div class="fall__foot">
      <p class="fall__promise">{{ site.promise }}</p>
      <a class="fall__cta" href="#burrow">Fall in <span aria-hidden="true">↓</span></a>
    </div>
  </div>
</section>

<section id="burrow" class="burrow" aria-labelledby="burrow-title" tabindex="-1">
  <header class="burrow__head">
    <p class="kicker kicker--glow">The burrow, in cross-section</p>
    <h2 id="burrow-title" class="burrow__title">{{ s.title }}</h2>
    <p class="burrow__intro">{{ site.intro }}</p>
    <p class="burrow__stats">
      <span><b>{{ things.length }}</b> finds</span>
      <span><b>{{ s.families.length }}</b> chambers</span>
      <span><b>2</b> sisters</span>
      <span><b>{{ site.cities.length }}</b> cities</span>
    </p>
    <nav class="map" aria-label="Chambers of the burrow">
      <ol class="map__list">
        {%- for fam in s.families %}{% set n = (things | byFamily(fam.key)).length %}{% if n %}
        <li><a class="map__link paint-{{ fam.colour }}" href="#{{ fam.key }}"><span class="map__dot" aria-hidden="true"></span>{{ fam.name }} <span class="map__n">{{ n }}</span></a></li>
        {%- endif %}{% endfor %}
      </ol>
    </nav>
  </header>

  {%- asyncEach ch in things | chambers(s) %}
  {%- set fam = ch.family %}
  <div class="tunnel tunnel--{{ 'a' if ch.n % 2 else 'b' }}" aria-hidden="true">
    <svg viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false"><path d="M28 0C28 55 72 45 72 100" vector-effect="non-scaling-stroke"/></svg>
  </div>
  <section class="chamber paint-{{ fam.colour }} chamber--{{ 'a' if ch.n % 2 else 'b' }}" id="{{ fam.key }}" aria-labelledby="ch-{{ fam.key }}">
    <header class="chamber__head">
      <p class="chamber__no">Chamber {{ ch.n | pad }}</p>
      <h3 class="chamber__name" id="ch-{{ fam.key }}"><a href="{{ fam.url }}">{{ fam.name }}</a></h3>
      <p class="chamber__blurb">{{ fam.blurb }}</p>
    </header>
    <ul class="finds" role="list">
      {% asyncEach item in ch.items %}{% include "partials/find-card.njk" %}{% endeach %}
    </ul>
  </section>
  {%- endeach %}

  {#- Anything whose family isn't listed in _shelf.yaml still shows up, here. -#}
  {%- set loose = things | looseFinds %}
  {%- if loose.length %}
  <div class="tunnel tunnel--a" aria-hidden="true"><svg viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false"><path d="M28 0C28 55 72 45 72 100" vector-effect="non-scaling-stroke"/></svg></div>
  <section class="chamber paint-paper chamber--b" id="loose" aria-labelledby="ch-loose">
    <header class="chamber__head">
      <p class="chamber__no">Side tunnel</p>
      <h3 class="chamber__name" id="ch-loose">Loose finds</h3>
      <p class="chamber__blurb">Still being sorted into a chamber.</p>
    </header>
    <ul class="finds" role="list">{% asyncEach item in loose %}{% include "partials/find-card.njk" %}{% endeach %}</ul>
  </section>
  {%- endif %}

  <div class="tunnel tunnel--end" aria-hidden="true"><svg viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false"><path d="M72 0C72 50 50 50 50 100" vector-effect="non-scaling-stroke"/></svg></div>
  <div class="burrow__end">
    {%- set target = things | fallTarget("/") %}
    <a class="fall-deeper__btn" href="{{ target.url }}" data-fall-deeper data-shelf="things">Fall deeper <span aria-hidden="true">↓</span></a>
    <p class="fall-deeper__line" data-depth-line>Takes you to a random find you haven't seen yet.</p>
  </div>
</section>
