---js
{
  permalink: "/404.html",
  layout: "layouts/base.njk",
  bodyClass: "inside lost",
  themeColour: "hole",
  title: "This tunnel caved in",
  noindex: true,
  eleventyExcludeFromCollections: true,
  card: { title: "This tunnel caved in", kicker: "404" },
}
---
{%- set things = collections.items | byShelf("things") %}
<section class="lost__inner" aria-labelledby="lost-title">
  {% mark { decorative: true, cls: "lost__mark", left: null, right: null, outline: "periwinkle" } %}
  <p class="kicker kicker--glow">404 · nobody home</p>
  <h1 id="lost-title" class="lost__title">This tunnel caved in.</h1>
  <p class="lost__text">Whatever lived here has burrowed off somewhere else. Both ears are out looking for it.</p>
  <p class="lost__actions">
    <a class="button" href="/">Back to the surface</a>
    {%- set target = things | fallTarget("404") %}
    {%- if target %}<a class="fall-deeper__btn" href="{{ target.url }}" data-fall-deeper data-shelf="things">Fall somewhere random <span aria-hidden="true">↓</span></a>{% endif %}
  </p>
</section>
