---js
{
  layout: "layouts/base.njk",
  bodyClass: "inside",
  themeColour: "hole",
  eleventyComputed: {
    card: (data) => {
      const shelves = data.shelves || [];
      const s = shelves.find((x) => x.key === data.shelf) || {};
      const fam = (s.families || []).find((f) => f.key === data.family);
      return {
        title: data.title,
        kicker: s.singular ? s.singular[0].toUpperCase() + s.singular.slice(1) : "Inside the hole",
        chip: fam ? fam.name : (data.year ? String(data.year) : ""),
        chipColour: fam ? fam.colour : "yolk",
        photoSrc: data.images && data.images[0] ? data.images[0].src : null,
      };
    },
  },
}
---
{%- set s = shelf | shelf %}
{%- set fam = shelf | family(family) %}
{%- set mine = collections.items | byShelf(shelf) %}
{%- set nb = mine | neighbours(page.url) %}
{%- set target = mine | fallTarget(page.url) %}
{%- set hasPhotos = images and images.length %}

<article class="item item--{{ s.look }}{% if fam %} paint-{{ fam.colour }}{% endif %}{% if not hasPhotos %} item--text{% endif %}" data-find="{{ page.url }}" data-shelf="{{ shelf }}">
  {%- if hasPhotos %}
  <div class="item__photos">
    {%- for img in images %}
    <figure class="item__fig{% if loop.first %} item__fig--first{% endif %}">
      {%- if loop.first %}
      {% photo img.src, img.alt, "full", "(min-width: 64em) 58vw, 100vw", { loading: "eager", fetchpriority: "high", class: "item__img" } %}
      {%- else %}
      {% photo img.src, img.alt, "full", "(min-width: 64em) 58vw, 100vw", { class: "item__img" } %}
      {%- endif %}
      <figcaption>
        {%- if img.caption %}<span>{{ img.caption }}</span>{% endif %}
        <a class="item__full" href="/photos/{{ img.src | replace('/assets/uploads/', '') | replace('assets/uploads/', '') }}">Full size<span class="visually-hidden"> photo: {{ img.caption or img.alt }}</span></a>
      </figcaption>
    </figure>
    {%- endfor %}
  </div>
  {%- endif %}

  <div class="item__side">
    <div class="tag tag--big">
      <span class="tag__hole" aria-hidden="true"></span>
      {%- if s.numbered %}<p class="tag__no">{{ s.singular | capitalize }} No. {{ page.url | findNo }}</p>{% endif %}
      <h1 class="tag__title">{{ title }}</h1>
      {%- if description %}<p class="tag__desc">{{ description }}</p>{% endif %}
      <dl class="tag__facts">
        {%- if fam %}<div><dt>Family</dt><dd><a href="{{ fam.url }}"><span class="dot" aria-hidden="true"></span>{{ fam.name }}</a></dd></div>{% endif %}
        {%- if habitat %}<div><dt>Habitat</dt><dd>{{ habitat }}</dd></div>{% endif %}
        {%- if maker %}<div><dt>Made by</dt><dd class="tag__maker">{% madeBy maker, "made-by made-by--m" %}<span>{{ maker | makers }}</span></dd></div>{% endif %}
        {%- if year %}<div><dt>Year</dt><dd>{{ year }}</dd></div>{% endif %}
        {%- if price %}<div><dt>Price</dt><dd>{{ price }}</dd></div>{% endif %}
      </dl>
      {%- if content | striptags | trim %}<div class="tag__story prose">{{ content | safe }}</div>{% endif %}
      {%- if buy or download %}
      <p class="tag__actions">
        {%- if buy %}<a class="button" href="{{ buy }}">{{ buy_label or "Get one" }} <span aria-hidden="true">→</span></a>{% endif %}
        {%- if download %}<a class="button" href="{{ download }}" download>Download <span aria-hidden="true">↓</span></a>{% endif %}
      </p>
      {%- endif %}
    </div>

    {%- if target %}
    <div class="fall-deeper">
      <a class="fall-deeper__btn" href="{{ target.url }}" data-fall-deeper data-shelf="{{ shelf }}">Fall deeper <span aria-hidden="true">↓</span></a>
      <p class="fall-deeper__line" data-depth-line>Takes you to a random {{ s.singular }} you haven't seen yet.</p>
    </div>
    {%- endif %}

    <nav class="item__nav" aria-label="Nearby">
      {%- if nb.newer %}<a class="item__nb item__nb--newer" href="{{ nb.newer.url }}"><span class="kicker">Newer</span>{{ nb.newer.data.title }}</a>{% endif %}
      {%- if nb.older %}<a class="item__nb item__nb--older" href="{{ nb.older.url }}"><span class="kicker">Older</span>{{ nb.older.data.title }}</a>{% endif %}
      {%- if fam %}<a class="item__nb item__nb--up" href="{{ ('/#' + fam.key) if shelf == 'things' else fam.url }}"><span class="kicker">Back to the chamber</span>{{ fam.name }}</a>{% endif %}
    </nav>
  </div>
</article>
