{#- One find, as a photo with a specimen tag hanging off it. Expects `item`. -#}
{%- set fam = item.data.shelf | family(item.data.family) %}
{%- set s = item.data.shelf | shelf %}
{%- set cover = item.data.images[0] if item.data.images else null %}
<li class="find{% if fam %} paint-{{ fam.colour }}{% endif %}">
  <a class="find__link" href="{{ item.url }}">
    <span class="find__photo">
      {%- if cover %}{% photo cover.src, cover.alt, "card", "(min-width: 75em) 19vw, (min-width: 48em) 28vw, 44vw" %}
      {%- else %}{% mark { decorative: true, cls: "find__placeholder" } %}{% endif -%}
    </span>
    <span class="find__tag">
      {%- if s.numbered %}<span class="find__no">No. {{ item.url | findNo }}</span>{% endif %}
      <span class="find__name">{{ item.data.title }}</span>
      <span class="find__meta">
        {%- if item.data.maker %}{% madeBy item.data.maker, "made-by" %}{% endif -%}
        {%- if item.data.year %}<span>{{ item.data.year }}</span>{% endif -%}
        {%- if item.data.price %}<span>{{ item.data.price }}</span>{% endif -%}
      </span>
    </span>
  </a>
</li>
